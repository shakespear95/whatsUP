# JWT Secrets for development (use strong random strings in production)
JWT_SECRET=your-super-secret-jwt-key-here-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-here-change-in-production

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=https://your-domain.vercel.app/api/auth/google/callback
REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id-here

# AI API Keys for dynamic event generation
OPENAI_API_KEY=your-openai-api-key-here
# GOOGLE_AI_API_KEY=your-gemini-api-key-here
# PERPLEXITY_API_KEY=your-perplexity-api-key-here
# SERP_API_KEY=your-serpapi-key-here

# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/eventfinder?retryWrites=true&w=majority

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Optional: Third-party API keys for event data sources
# TICKETMASTER_API_KEY=your-ticketmaster-api-key
# EVENTBRITE_API_KEY=your-eventbrite-api-key

# Optional: Google Maps API key for map features
# REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional: Analytics
# REACT_APP_GOOGLE_ANALYTICS_ID=your_ga_id_here